# Зависимости и сборка — восстанавливаются командами, в репозитории не нужны.
node_modules/
dist/
.vite/

# Артефакты проверок: скриншоты, профили Chrome, временные диагностические
# скрипты. Всё это создаётся заново запуском `smoke.mjs` / `showcase.mjs`.
.verify/

# Локальные настройки и системный мусор.
*.local
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini

# Файлы редакторов.
.vscode/
.idea/
*.swp
*~

# Логи и дампы.
*.log
npm-debug.log*
yarn-error.log*

# Сообщения коммитов, подготовленные во временном файле.
# Такие файлы уже дважды попадали в историю: создаются, используются с
# `git commit -F` и удаляются, но при `git add -A` успевают попасть в индекс.
# Шаблон намеренно широкий — любое короткое имя в корне с этими словами.
/msg.txt
/*msg*.txt

# Отладочные заготовки тестов и замеров. Ядро тестов лежит в src/test/,
# а файлы вида zz-*.test.ts — временные и в репозитории не нужны.
src/test/zz-*.test.ts
src/test/zz*.test.ts
